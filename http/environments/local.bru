vars {
  @description('''
    URL base do servidor local
    
  ''')
  baseURL: localhost:8080
  @description('URL configurado no Docker')
  dockerURL: localhost:8081
}
vars:secret [
  @description('Token de acesso dos alunos a API MyMovies')
  user_token,
  @description('Token de acesso expirado a API MyMovies')
  expired_token,
  @description('Token Admin da API MyMovies')
  admin_token
]
